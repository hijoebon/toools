generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Tool {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  tagline       String
  description   String
  url           String
  iconUrl       String?
  screenshotUrl String?

  embedMode   EmbedMode @default(EXTERNAL)
  embedUrl    String?
  embedConfig Json?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  tags       ToolTag[]

  pricing      Pricing  @default(FREE)
  platforms    String[] @default([])
  github       String?
  isOpenSource Boolean  @default(false)

  status   ToolStatus @default(PENDING)
  featured Boolean    @default(false)

  viewCount  Int @default(0)
  clickCount Int @default(0)

  phVotes     Int?
  githubStars Int?
  source      ToolSource?
  sourceUrl   String?

  identities  ToolIdentity[]
  discoveries ToolDiscovery[]

  useCases String[] @default([])
  pros     String[] @default([])
  cons     String[] @default([])

  stageRecommendations StageRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

// Global identity aliases prevent one repository or website becoming two tools.
model ToolIdentity {
  key       String   @id
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([toolId])
}

// Durable deduplication for at-least-once queue delivery. No Tool foreign key:
// deleting a listing must not leave its already accepted events unacknowledgeable.
model ToolMetricReceipt {
  id         String   @id
  toolId     String
  metric     String
  occurredAt DateTime
  appliedAt  DateTime @default(now())

  @@index([appliedAt])
}

// Discovery provenance is additive; source/sourceUrl on Tool remain compatible.
model ToolDiscovery {
  id          String     @id @default(cuid())
  toolId      String
  tool        Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)
  source      ToolSource
  method      String
  sourceKey   String
  sourceUrl   String
  metadata    Json?
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())

  @@unique([toolId, source, method, sourceKey])
  @@index([source, method])
}

model Stack {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  tagline     String
  description String
  icon        String?
  sortOrder   Int     @default(0)

  stages Stage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stage {
  id          String  @id @default(cuid())
  name        String
  description String?
  editorNote  String?
  sortOrder   Int     @default(0)

  stackId String
  stack   Stack  @relation(fields: [stackId], references: [id], onDelete: Cascade)

  recommendations StageRecommendation[]

  @@index([stackId])
}

model StageRecommendation {
  stageId   String
  toolId    String
  sortOrder Int    @default(0)

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([stageId, toolId])
  @@index([toolId])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  tools       Tool[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  tools ToolTag[]
}

model ToolTag {
  toolId String
  tagId  String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([toolId, tagId])
}


// Side-path daily UA actor aggregates for human vs bot trend SQL.
// Does not affect Tool.viewCount / clickCount. Days are UTC (@db.Date).
model UaActorMetricDaily {
  day           DateTime @db.Date
  uaFingerprint String
  uaPreview     String
  actorClass    String
  botFamily     String?
  metric        String
  count         Int      @default(0)

  @@id([day, uaFingerprint, metric])
  @@index([day, actorClass])
  @@index([day, botFamily])
  @@index([day, metric])
}

enum EmbedMode {
  IFRAME
  API
  EXTERNAL
}

enum Pricing {
  FREE
  FREEMIUM
  PAID
  OPEN_SOURCE
}

enum ToolStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ToolSource {
  MANUAL
  PRODUCT_HUNT
  AWESOME_LIST
  GITHUB_REPOSITORY
  GITHUB_DIRECTORY
}
